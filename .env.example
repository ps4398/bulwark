# Bulwark — environment variables
# Генерируется автоматически при ./setup.sh — ручное редактирование обычно не требуется.
# setup.sh заполняет Telegram credentials, SSH-пароль management-ноды и API-префиксы.
# Бот дописывает SSH-пароли новых нод при добавлении через wizard.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Portal (опционально — для портала подписок)
PORTAL_PASSWORD=
SUBSCRIPTION_UUID=

# Cloudflare Tunnel (опционально)
CF_TUNNEL_ID=
CF_ACCOUNT_ID=
CF_API_TOKEN=
