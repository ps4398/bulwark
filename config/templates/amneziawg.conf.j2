# AmneziaWG server configuration
# Generated by Bulwark CLI for node: {{ node_name }}
# Region: {{ region }} | Address: 10.{{ region_octet }}.0.1/24

[Interface]
PrivateKey = {{ private_key }}
Address = 10.{{ region_octet }}.0.1/24
ListenPort = {{ listen_port | default(51820) }}

# AmneziaWG obfuscation parameters (AWG 2.0)
Jc = {{ jc | default(4) }}
Jmin = {{ jmin | default(40) }}
Jmax = {{ jmax | default(70) }}
S1 = {{ s1 }}
S2 = {{ s2 }}
S3 = {{ s3 | default(0) }}
S4 = {{ s4 | default(0) }}
{% if h1_range is defined and h1_range > 0 %}
H1 = {{ h1 }}-{{ h1 + h1_range }}
H2 = {{ h2 }}-{{ h2 + h2_range }}
H3 = {{ h3 }}-{{ h3 + h3_range }}
H4 = {{ h4 }}-{{ h4 + h4_range }}
{% else %}
H1 = {{ h1 }}
H2 = {{ h2 }}
H3 = {{ h3 }}
H4 = {{ h4 }}
{% endif %}
{% if i1 is defined and i1 %}
i1 = {{ i1 }}
{% endif %}
{% if i2 is defined and i2 %}
i2 = {{ i2 }}
{% endif %}
{% if i3 is defined and i3 %}
i3 = {{ i3 }}
{% endif %}

# NAT and packet forwarding
PostUp = iptables -A FORWARD -i %i -j ACCEPT; iptables -A FORWARD -o %i -j ACCEPT; iptables -t nat -A POSTROUTING -o {{ outbound_iface | default('eth0') }} -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -D FORWARD -o %i -j ACCEPT; iptables -t nat -D POSTROUTING -o {{ outbound_iface | default('eth0') }} -j MASQUERADE

{% for peer in peers %}
# Peer: {{ peer.name }}
[Peer]
PublicKey = {{ peer.public_key }}
{% if peer.preshared_key is defined and peer.preshared_key %}
PresharedKey = {{ peer.preshared_key }}
{% endif %}
AllowedIPs = {{ peer.address if peer.address is defined else '10.' ~ region_octet ~ '.0.' ~ (loop.index + 1) }}/32
{% if peer.keepalive is defined %}
PersistentKeepalive = {{ peer.keepalive }}
{% endif %}

{% endfor %}
