# Hysteria2 server configuration
# Generated by Bulwark CLI for node: {{ node_name }}

listen: ":{{ hysteria2_port | default(8443) }}"

tls:
  cert: /etc/hysteria/server.crt
  key: /etc/hysteria/server.key

auth:
{% if hy2_users %}
  type: userpass
  userpass:
{% for name, password in hy2_users.items() %}
    {{ name }}: "{{ password }}"
{% endfor %}
{% else %}
  type: password
  password: "{{ hysteria2_password }}"
{% endif %}

masquerade:
  type: proxy
  proxy:
    url: https://news.ycombinator.com/
    rewriteHost: true

bandwidth:
  up: {{ bandwidth_up | default('1 gbps') }}
  down: {{ bandwidth_down | default('1 gbps') }}

ignoreClientBandwidth: false

quic:
  initStreamReceiveWindow: 8388608
  maxStreamReceiveWindow: 8388608
  initConnReceiveWindow: 20971520
  maxConnReceiveWindow: 20971520
  maxIdleTimeout: 30s
  maxIncomingStreams: 1024
  disablePathMTUDiscovery: false

speedTest: false

logging:
  level: warn
  output: /var/log/hysteria2/access.log
  timestamp: true
